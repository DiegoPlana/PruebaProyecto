{
  "name": "santa-quiteria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "admin": "node --env-file-if-exists=.env scripts/admin.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "format": "prettier --write \"src/**/*.mjs\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"public/**/*.js\" \"public/**/*.css\" \"public/*.html\" \"frontend/**/*.html\" package.json .prettierrc.json && npm run build:pages",
    "format:check": "prettier --check \"src/**/*.mjs\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"public/**/*.js\" \"public/**/*.css\" \"public/*.html\" \"frontend/**/*.html\" package.json .prettierrc.json"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
